# ============================================================
# .env.example — template des variables d'environnement.
# Committable. Copier vers `.env.local` (gitignored) puis
# remplir les valeurs réelles localement.
#
# Côté Vercel : reproduire ces variables dans
# Settings → Environment Variables (scope Preview + Production).
# ============================================================

# Resend — transactional email pour les leads (formulaires).
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur (domaine vérifié dans Resend).
# Fallback dev : `Acme <onboarding@resend.dev>` (100 emails/jour
# vers le seul email du compte Resend).
RESEND_FROM=Agence 3E <noreply@agence3e.fr>

# Destinataire interne où arrivent les notifications de leads.
RESEND_TO_INTERNAL=contact@agence3e.fr
